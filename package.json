{
  "name": "shivtek",
  "version": "1.0.0",
  "private": true,
  "description": "Shivtek Spechemi Industries Ltd - Full Stack Application",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
